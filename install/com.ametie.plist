<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ametie</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ametie-client</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/ametie.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/ametie.error.log</string>
</dict>
</plist>

